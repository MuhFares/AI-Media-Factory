{
  "name": "@ai-media-factory/orchestrator",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic, directive-driven orchestration boundary. Compiles capability directives into reusable workflow plans and delegates execution to the Workflow Engine over the AgentExecutorPort. Contracts and implementation.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node --test"
  },
  "dependencies": {
    "@ai-media-factory/shared": "*",
    "@ai-media-factory/workflow-engine": "*",
    "@ai-media-factory/runtime": "*"
  },
  "devDependencies": {
    "@ai-media-factory/agent-registry": "*",
    "@ai-media-factory/tool-framework": "*",
    "@ai-media-factory/planner-agent": "*",
    "@ai-media-factory/research-agent": "*",
    "@ai-media-factory/ceo-agent": "*",
    "@ai-media-factory/writer-agent": "*",
    "@ai-media-factory/seo-agent": "*",
    "typescript": "^5.5.0"
  }
}