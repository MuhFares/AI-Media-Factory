{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-media-factory/agents/analytics/input.schema.json",
  "title": "AnalyticsInput",
  "description": "Events consumed by the Analytics agent. Analytics is a fan-in agent: PublishingFinished is its primary trigger for revenue attribution and the AnalyticsReported output, while ProductionStepFinished represents any pipeline completion event it measures (measure every workflow and agent). Every variant shares the common event envelope.",
  "type": "object",
  "oneOf": [
    { "$ref": "#/definitions/PublishingFinished" },
    { "$ref": "#/definitions/ProductionStepFinished" }
  ],
  "definitions": {
    "PublishingFinished": {
      "type": "object",
      "required": ["schema_version", "event_id", "workflow_id", "timestamp", "type", "source_agent", "target_agent", "payload"],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "type": "string", "const": "1.0.0" },
        "event_id": { "type": "string", "format": "uuid" },
        "workflow_id": { "type": "string", "format": "uuid" },
        "correlation_id": { "type": ["string", "null"] },
        "brand_id": { "type": ["string", "null"] },
        "asset_id": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "type": { "type": "string", "const": "PublishingFinished" },
        "source_agent": { "type": "string", "const": "publisher" },
        "target_agent": { "type": "string", "const": "analytics" },
        "payload": {
          "type": "object",
          "required": ["asset_id", "published_refs"],
          "additionalProperties": false,
          "properties": {
            "asset_id": { "type": "string" },
            "published_refs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["platform", "ref"],
                "additionalProperties": false,
                "properties": {
                  "platform": { "type": "string" },
                  "ref": { "type": "string" },
                  "url": { "type": ["string", "null"] },
                  "published_at": { "type": ["string", "null"], "format": "date-time" }
                }
              }
            }
          }
        },
        "metadata": {
          "type": "object",
          "properties": {
            "cost_usd": { "type": "number" },
            "model": { "type": "string" },
            "latency_ms": { "type": "number" }
          }
        }
      }
    },
    "ProductionStepFinished": {
      "type": "object",
      "description": "Generic completion event Analytics subscribes to for measurement of any workflow step or agent.",
      "required": ["schema_version", "event_id", "workflow_id", "timestamp", "type", "source_agent", "target_agent", "payload"],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "type": "string", "const": "1.0.0" },
        "event_id": { "type": "string", "format": "uuid" },
        "workflow_id": { "type": "string", "format": "uuid" },
        "correlation_id": { "type": ["string", "null"] },
        "brand_id": { "type": ["string", "null"] },
        "asset_id": { "type": ["string", "null"] },
        "timestamp": { "type": "string", "format": "date-time" },
        "type": {
          "type": "string",
          "enum": ["ResearchFinished", "ScriptFinished", "SEOFinished", "ThumbnailFinished", "VideoFinished", "QAReviewed", "PublishApproved"]
        },
        "source_agent": { "type": "string" },
        "target_agent": { "type": "string", "const": "analytics" },
        "payload": { "type": "object" },
        "metadata": {
          "type": "object",
          "properties": {
            "cost_usd": { "type": "number" },
            "model": { "type": "string" },
            "latency_ms": { "type": "number" }
          }
        }
      }
    }
  }
}
