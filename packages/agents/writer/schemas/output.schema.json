{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-media-factory/agents/writer/output.schema.json",
  "title": "ScriptFinished",
  "description": "Event emitted by the Writer agent to the SEO agent with a finished, on-voice script.",
  "type": "object",
  "required": ["schema_version", "event_id", "workflow_id", "timestamp", "type", "source_agent", "target_agent", "payload"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "event_id": { "type": "string", "format": "uuid" },
    "workflow_id": { "type": "string", "format": "uuid" },
    "correlation_id": { "type": ["string", "null"] },
    "brand_id": { "type": ["string", "null"] },
    "asset_id": { "type": ["string", "null"] },
    "timestamp": { "type": "string", "format": "date-time" },
    "type": { "type": "string", "const": "ScriptFinished" },
    "source_agent": { "type": "string", "const": "writer" },
    "target_agent": { "type": "string", "const": "seo" },
    "payload": {
      "type": "object",
      "required": ["asset_id", "script", "hook", "sections", "word_count", "brand_voice_applied", "citations"],
      "additionalProperties": false,
      "properties": {
        "asset_id": { "type": "string" },
        "script": { "type": "string" },
        "hook": { "type": "string" },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title", "body"],
            "properties": {
              "title": { "type": "string" },
              "body": { "type": "string" }
            }
          }
        },
        "word_count": { "type": "integer", "minimum": 0 },
        "brand_voice_applied": { "type": "boolean", "const": true },
        "citations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["claim", "source_ref"],
            "properties": {
              "claim": { "type": "string" },
              "source_ref": { "type": "string" }
            }
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "cost_usd": { "type": "number" },
        "model": { "type": "string" },
        "latency_ms": { "type": "number" }
      }
    }
  }
}
