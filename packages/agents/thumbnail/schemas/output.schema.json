{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-media-factory/agents/thumbnail/output.schema.json",
  "title": "ThumbnailFinished",
  "description": "Event emitted by the Thumbnail agent to the Video agent with rendered cover imagery.",
  "type": "object",
  "required": ["schema_version", "event_id", "workflow_id", "timestamp", "type", "source_agent", "target_agent", "payload"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "event_id": { "type": "string", "format": "uuid" },
    "workflow_id": { "type": "string", "format": "uuid" },
    "correlation_id": { "type": ["string", "null"] },
    "brand_id": { "type": ["string", "null"] },
    "asset_id": { "type": ["string", "null"] },
    "timestamp": { "type": "string", "format": "date-time" },
    "type": { "type": "string", "const": "ThumbnailFinished" },
    "source_agent": { "type": "string", "const": "thumbnail" },
    "target_agent": { "type": "string", "const": "video" },
    "payload": {
      "type": "object",
      "required": ["thumbnail_asset_ref", "variants", "concept", "render_cost_usd"],
      "additionalProperties": false,
      "properties": {
        "thumbnail_asset_ref": { "type": "string" },
        "variants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["variant_id", "asset_ref"],
            "properties": {
              "variant_id": { "type": "string" },
              "asset_ref": { "type": "string" },
              "is_primary": { "type": "boolean" },
              "rationale": { "type": "string" }
            }
          }
        },
        "concept": { "type": "string" },
        "render_cost_usd": { "type": "number", "minimum": 0 }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "cost_usd": { "type": "number" },
        "model": { "type": "string" },
        "latency_ms": { "type": "number" }
      }
    }
  }
}
