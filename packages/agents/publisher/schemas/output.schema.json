{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-media-factory/agents/publisher/output.schema.json",
  "title": "PublishingFinished",
  "description": "Event emitted by the Publisher agent to Analytics after distributing an approved asset.",
  "type": "object",
  "required": ["schema_version", "event_id", "workflow_id", "timestamp", "type", "source_agent", "target_agent", "payload"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "event_id": { "type": "string", "format": "uuid" },
    "workflow_id": { "type": "string", "format": "uuid" },
    "correlation_id": { "type": ["string", "null"] },
    "brand_id": { "type": ["string", "null"] },
    "asset_id": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "type": { "type": "string", "const": "PublishingFinished" },
    "source_agent": { "type": "string", "const": "publisher" },
    "target_agent": { "type": "string", "const": "analytics" },
    "payload": {
      "type": "object",
      "required": ["asset_id", "published_refs", "status"],
      "additionalProperties": false,
      "properties": {
        "asset_id": { "type": "string" },
        "published_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["platform", "url", "published_at"],
            "additionalProperties": false,
            "properties": {
              "platform": { "type": "string", "enum": ["youtube", "tiktok", "instagram", "x", "facebook", "linkedin"] },
              "url": { "type": "string", "format": "uri" },
              "published_at": { "type": "string", "format": "date-time" }
            }
          }
        },
        "schedule": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "planned_start": { "type": ["string", "null"], "format": "date-time" },
            "planned_end": { "type": ["string", "null"], "format": "date-time" },
            "stagger_minutes": { "type": "number", "minimum": 0 }
          }
        },
        "status": { "type": "string", "enum": ["published", "partial", "scheduled", "held", "failed"] }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "cost_usd": { "type": "number" },
        "model": { "type": "string" },
        "latency_ms": { "type": "number" }
      }
    }
  }
}
