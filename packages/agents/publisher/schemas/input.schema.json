{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-media-factory/agents/publisher/input.schema.json",
  "title": "PublishApproved",
  "description": "Event consumed by the Publisher agent to trigger a publish cycle. Emitted only after the Brand and QA gates approve.",
  "type": "object",
  "required": ["schema_version", "event_id", "workflow_id", "timestamp", "type", "source_agent", "target_agent", "payload"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "event_id": { "type": "string", "format": "uuid" },
    "workflow_id": { "type": "string", "format": "uuid" },
    "correlation_id": { "type": ["string", "null"] },
    "brand_id": { "type": ["string", "null"] },
    "asset_id": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "type": { "type": "string", "const": "PublishApproved" },
    "source_agent": { "type": "string" },
    "target_agent": { "type": "string", "const": "publisher" },
    "payload": {
      "type": "object",
      "required": ["asset_id", "platforms", "approvals"],
      "additionalProperties": false,
      "properties": {
        "asset_id": { "type": "string" },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["platform"],
            "additionalProperties": false,
            "properties": {
              "platform": { "type": "string", "enum": ["youtube", "tiktok", "instagram", "x", "facebook", "linkedin"] },
              "handle": { "type": "string" },
              "publish_at": { "type": ["string", "null"], "format": "date-time" }
            }
          }
        },
        "approvals": {
          "type": "object",
          "required": ["brand", "qa"],
          "additionalProperties": false,
          "properties": {
            "brand": { "type": "boolean", "const": true },
            "qa": { "type": "boolean", "const": true }
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "cost_usd": { "type": "number" },
        "model": { "type": "string" },
        "latency_ms": { "type": "number" }
      }
    }
  }
}
