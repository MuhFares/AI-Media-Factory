# ---- Copy this file to .env and fill in real values. Never commit .env. ----

# Runtime
APP_ENV=development
LOG_LEVEL=info

# API service (apps/api)
API_HOST=0.0.0.0
API_PORT=8000

# Web app (apps/web)
WEB_PORT=3000
API_BASE_URL=http://localhost:8000

# AI provider credentials (placeholders - do not use real keys here)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Storage / media output
MEDIA_OUTPUT_DIR=./output
