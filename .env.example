# ---- Copy this file to .env and fill in real values. Never commit .env. ----

# Runtime
APP_ENV=development
LOG_LEVEL=info

# API service (apps/api)
API_HOST=0.0.0.0
API_PORT=8000

# Web app (apps/web)
WEB_PORT=3000
API_BASE_URL=http://localhost:8000

# AI provider credentials (placeholders - do not use real keys here)
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
DASHSCOPE_API_KEY=
REPLICATE_API_TOKEN=
# --- Provider registries (all capabilities) ---
# Every capability routes through a registry: registered = credential present,
# active = *_PROVIDER env, else first configured in provider order.
# Switching providers is configuration only — agents never change.
#
# Web search: tavily -> serper -> exa -> brave
SEARCH_PROVIDER=tavily-search
# tavily-search
SEARCH_API=
# SEARCH_API_TAVILY=
# TAVILY_API_KEY=
# serper
SEARCH_API_SERPER=
# SERPER_API_KEY=
# exa
SEARCH_API_EXA=
# EXA_API_KEY=
# brave-search
SEARCH_API_BRAVE=
# BRAVE_SEARCH_API_KEY=
# BRAVE_API_KEY=
#
# Image generation: openai-image -> self-hosted-image (GPU, ComfyUI + FLUX.1-dev-fp8)
# openai-image is OpenAI Images API; self-hosted-image is RunPod Serverless ComfyUI.
IMAGE_PROVIDER=openai-image
# OPENAI_API_KEY is already above (openai-image)
# OPENAI_BASE_URL=https://api.openai.com/v1
# IMAGE_GENERATION_MODEL=dall-e-3
# self-hosted GPU image — RunPod Serverless ComfyUI 5.8.7 / FLUX.1-dev-fp8
# RUNPOD_API_KEY=                          # or SELF_HOSTED_IMAGE_API_KEY
# RUNPOD_IMAGE_ENDPOINT_ID=                # RunPod endpoint ID (e.g. abc123def4)
# RUNPOD_BASE_URL=https://api.runpod.ai/v2 # optional override
# Optional polling tuning:
# RUNPOD_IMAGE_TIMEOUT_MS=30000
# RUNPOD_IMAGE_POLL_INTERVAL_MS=4000
# RUNPOD_IMAGE_MAX_WAIT_MS=180000
#
# Video generation: replicate -> self-hosted-video (GPU, Wan2.2 image-to-video)
# replicate is Replicate Predictions API; self-hosted-video is RunPod Wan2.2.
VIDEO_PROVIDER=replicate
# REPLICATE_API_TOKEN is already above (replicate)
# REPLICATE_BASE_URL=https://api.replicate.com/v1
# VIDEO_GENERATION_MODEL=stability-ai/stable-video-diffusion
# self-hosted GPU video — RunPod Serverless Wan2.2 (image-to-video)
# RUNPOD_API_KEY is already above (reused for video)
# RUNPOD_VIDEO_ENDPOINT_ID=               # RunPod video endpoint ID (e.g. ry49lc45y50ldy)
# RUNPOD_BASE_URL=https://api.runpod.ai/v2 # optional override
# Optional Wan2.2 defaults (prompt/negative_prompt/image_base64 + width/height/length/steps/cfg/seed):
# RUNPOD_VIDEO_TIMEOUT_MS=30000
# RUNPOD_VIDEO_POLL_INTERVAL_MS=4000
# RUNPOD_VIDEO_MAX_WAIT_MS=600000
#
# TTS: groq (Saudi/MSA) -> voicetut (Egyptian, self-hosted RunPod serverless)
# groq: GROQ_API_KEY (or TTS_API_KEY). Models: canopylabs/orpheus-*
# voicetut: deploy docker/voicetut-tts/ to RunPod serverless first
#           (see docker/voicetut-tts/README.md), then set the endpoint id.
TTS_PROVIDER=groq
TTS_API_KEY=
# GROQ_API_KEY=                             # alias of TTS_API_KEY
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# RUNPOD_API_KEY is already above (voicetut reuses it)
# VOICETUT_TTS_ENDPOINT_ID=
# Optional tuning:
# TTS_TIMEOUT_MS=30000
# TTS_MAX_RETRIES=1
# TTS_POLL_INTERVAL_MS=3000
# TTS_MAX_WAIT_MS=300000

# Publishing: youtube (YouTube Data API v3, resumable upload)
PUBLISH_PROVIDER=youtube
YOUTUBE_ACCESS_TOKEN=
# GOOGLE_API_BASE_URL=https://www.googleapis.com
#
# Analytics: youtube-analytics (YouTube Analytics API v2)
ANALYTICS_PROVIDER=youtube-analytics
# YOUTUBE_ACCESS_TOKEN is shared with publishing (youtube-analytics)
# YOUTUBE_ANALYTICS_BASE_URL=https://youtubeanalytics.googleapis.com

# Storage / media output
MEDIA_OUTPUT_DIR=./output

# Database (apps/api, apps/worker, packages/database)
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/ai_media_factory
